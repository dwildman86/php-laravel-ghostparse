{
    "name": "wildye/email-parser-laravel",
    "description": "Laravel integration for GhostParse: a verified webhook route that turns inbound email into Laravel events.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "email", "inbound", "webhook", "parser"],
    "authors": [{ "name": "WILDYE LIMITED" }],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "wildye/email-parser": "^1.2"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": { "psr-4": { "Wildye\\EmailParser\\Laravel\\": "src/" } },
    "autoload-dev": { "psr-4": { "Wildye\\EmailParser\\Laravel\\Tests\\": "tests/" } },
    "extra": {
        "laravel": {
            "providers": ["Wildye\\EmailParser\\Laravel\\EmailParserServiceProvider"],
            "aliases": { "EmailParser": "Wildye\\EmailParser\\Laravel\\Facades\\EmailParser" }
        }
    },
    "config": { "sort-packages": true }
}
